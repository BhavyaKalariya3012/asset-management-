# PostgreSQL connection string (Neon). Include ?sslmode=require for Neon.
DATABASE_URL="postgresql://USER:PASS@HOST/db?sslmode=require"

# Secret used to sign NextAuth JWT sessions. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Base URL of the app. Use the production URL on Vercel.
NEXTAUTH_URL="http://localhost:3000"
